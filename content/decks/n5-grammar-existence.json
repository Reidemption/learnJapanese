      "prompt": "{冷蔵庫|れいぞうこ|fridge}の{中|なか|inside}に{何|なに}も___。",
      "en": "There is nothing in the fridge.",
      "answer": "ありません",
      "distractors": [
        "あります",
        "いません",
        "います"
      ]
    },
    {
