  "questions": [
    {
      "id": "n5-grammar-existence-q1",
      "prompt": "{部屋|へや|room}に{猫|ねこ|cat}が___。",
      "en": "There is a cat in the room.",
      "answer": "います",
      "distractors": [
        "あります",
        "です",
        "なります"
      ]
    },
    {
      "id": "n5-grammar-existence-q2",
      "prompt": "{つくえ||desk}の{上|うえ|on top of}に{本|ほん|book}が___。",
      "en": "There is a book on the desk.",
      "answer": "あります",
      "distractors": [
        "います",
        "です",
        "なります"
      ]
    },
    {
      "id": "n5-grammar-existence-q3",
      "prompt": "{公園|こうえん|park}に{子|こ|child}どもが___か。",
      "en": "Are there children in the park?",
      "answer": "います",
      "distractors": [
        "あります",
        "です",
        "しています"
      ]
    },
    {
