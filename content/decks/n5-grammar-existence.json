      "distractors": [
        "います",
        "なります",
        "きます"
      ]
    },
    {
      "id": "n5-grammar-existence-q12",
      "prompt": "{山田|やまだ|Yamada (a surname)}さんは{今|いま|now}{会社|かいしゃ|office / company}に___。",
      "en": "Mr Yamada is at the office now.",
      "answer": "います",
      "distractors": [
        "あります",
        "なります",
        "です"
      ]
