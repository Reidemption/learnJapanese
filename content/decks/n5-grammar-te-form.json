      "en": "て-form of 食べる"
    },
    {
      "id": "n5-grammar-te-form-11",
      "ja": "{行|い}って",
      "en": "て-form of 行く (irregular)"
    },
    {
      "id": "n5-grammar-te-form-12",
      "ja": "して",
      "en": "て-form of する"
    }
