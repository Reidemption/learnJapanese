      "ja": "〜てはいけません",
      "en": "must not do"
    },
    {
      "id": "n5-grammar-te-form-5",
      "ja": "〜てから",
      "en": "after doing"
    },
    {
      "id": "n5-grammar-te-form-6",
      "ja": "〜て、",
      "en": "and then (joining sentences)"
    },
    {
      "id": "n5-grammar-te-form-7",
      "ja": "〜ないでください",
      "en": "please don't do"
    },
    {
