      "ja": "〜ことができます",
      "en": "can do"
    },
    {
      "id": "n5-grammar-patterns-1-3",
      "ja": "〜{前|まえ}に",
      "en": "before doing"
    },
    {
      "id": "n5-grammar-patterns-1-4",
      "ja": "〜{後|あと}で",
      "en": "after doing"
    },
    {
      "id": "n5-grammar-patterns-1-5",
      "ja": "〜ながら",
      "en": "while doing"
    },
    {
      "id": "n5-grammar-patterns-1-6",
      "ja": "〜から",
      "en": "because / so"
    },
    {
      "id": "n5-grammar-patterns-1-7",
      "ja": "〜ので",
      "en": "because (softer)"
    },
    {
      "id": "n5-grammar-patterns-1-8",
      "ja": "〜が",
      "en": "but"
    },
    {
      "id": "n5-grammar-patterns-1-9",
      "ja": "でも",
      "en": "but (starting a sentence)"
    },
    {
      "id": "n5-grammar-patterns-1-10",
      "ja": "もう",
      "en": "already"
    },
    {
      "id": "n5-grammar-patterns-1-11",
      "ja": "まだ",
      "en": "not yet / still"
    },
    {
      "id": "n5-grammar-patterns-1-12",
      "ja": "〜{方|かた}",
      "en": "the way to do something"
    }
